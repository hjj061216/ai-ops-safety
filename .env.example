# Copy to .env if needed. Existing environment variables take precedence.
# Keep secrets in backend configuration only; never commit .env.
# deepseek | openai_compatible | ollama
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096

# For another compatible HTTPS Chat Completions provider:
# Set LLM_PROVIDER=openai_compatible, then fill these three fields.
# Never reuse or publish someone else's key. No fallback to DEEPSEEK_API_KEY.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Set prompt_only if the provider does not accept response_format.
LLM_JSON_MODE=json_object
LLM_TOKEN_LIMIT_PARAM=max_tokens

# Optional local provider; ignored unless LLM_PROVIDER=ollama.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434/api/chat
